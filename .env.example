# Primary Video Analysis Vision Engine (OpenRouter API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Use 'openrouter/free' meta-slug for automatic health-checks and dynamic routing to healthy free models
OPENROUTER_MODEL=openrouter/free
PRIMARY_VISION_PROVIDER=openrouter

# Fallback models configurations
GEMINI_API_KEY=your_gemini_api_key_here
SAKANA_API_KEY=your_sakana_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here
