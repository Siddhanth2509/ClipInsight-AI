{
  "manifest_version": 3,
  "name": "ClipInsight AI — 1-Click Video Analyzer",
  "version": "1.0.0",
  "description": "Analyze Instagram Reels, TikToks, and YouTube Shorts with 1 click using ClipInsight AI.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Analyze Video in ClipInsight AI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
